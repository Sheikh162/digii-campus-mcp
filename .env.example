# Copy to .env and fill in. Never commit .env.
# Your college portal base URL (no trailing slash):
DIGII_BASE_URL=https://<your-college>.digiicampus.com
# Your numeric student id (ukid — see your profile URL /users/<ukid>/...):
DIGII_UKID=
# JWT: log into the portal, DevTools > Application > Local Storage >
# userInfo > token (or the 'user' cookie value). Refresh when tools
# start raising TOKEN_EXPIRED.
DIGII_AUTH_TOKEN=
# Current term id for attendance (optional, default 32):
DIGII_TERM=32
